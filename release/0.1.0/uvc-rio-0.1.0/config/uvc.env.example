# Non-secret device identity. Keep the default unless this is not the first RIO.
UVC_HARDWARE_DEVICE_ID=rio

# Glue/CHUM rendezvous. When empty, the service starts in local-only,
# uncommissioned mode with Glue services disabled.
COMM_SERVER_URL=
PUBLIC_COMM_SERVER_URL=

# QUICVC listens on UDP 49497 by default. Open only this port on the intended
# trusted groov network interface.
QUICVC_PORT=49497
PUBLIC_QUICVC_HOST=
PUBLIC_QUICVC_PORT=

# Groov Manage authority commissioning. Leave every value empty until the
# dedicated API user and exact output channel are known. Supplying only some
# values is a startup error.
GROOV_AUTHORITY_ID=
GROOV_MANAGE_BASE_URL=
GROOV_MANAGE_API_KEY=
GROOV_IO_DEVICE=local
GROOV_MODULE_INDEX=
GROOV_CHANNEL_INDEX=
GROOV_OUTPUT_KIND=
GROOV_ANALOG_MIN=
GROOV_ANALOG_MAX=
GROOV_ANALOG_OFF_VALUE=
GROOV_ANALOG_READBACK_TOLERANCE=
GROOV_REQUEST_TIMEOUT_MS=5000
GROOV_TLS_CA_FILE=
GROOV_TLS_REJECT_UNAUTHORIZED=true
