[Unit]
Description=Refinio UVC authority for Opto 22 groov RIO
Documentation=https://refinio.one/downloads/uvc/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@UVC_USER@
Group=@UVC_GROUP@
WorkingDirectory=@UVC_ROOT@/shared
Environment=UVC_ROOT=@UVC_ROOT@
Environment=UVC_NODE=@UVC_NODE@
EnvironmentFile=-@UVC_ROOT@/shared/uvc.env
ExecStart=@UVC_ROOT@/current/bin/run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=@UVC_ROOT@/shared
StandardOutput=journal
StandardError=journal
SyslogIdentifier=uvc-rio

[Install]
WantedBy=multi-user.target
