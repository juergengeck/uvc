#!/bin/sh

set -eu

uvc_fail() {
  printf 'uvc-rio: %s\n' "$*" >&2
  exit 1
}

uvc_root() {
  printf '%s\n' "${UVC_ROOT:-/home/dev/uvc}"
}

uvc_detect_model() {
  if [ -n "${UVC_RIO_MODEL:-}" ]; then
    printf '%s\n' "$UVC_RIO_MODEL"
    return
  fi

  for file in \
    /sys/firmware/devicetree/base/model \
    /proc/device-tree/model \
    /etc/opto22-release \
    /etc/groov-release
  do
    if [ -f "$file" ]; then
      model="$(tr '\000' '\n' < "$file" | grep -Eo 'GRV-R7-[A-Z0-9-]+' | head -n 1 || true)"
      if [ -n "$model" ]; then
        printf '%s\n' "$model"
        return
      fi
    fi
  done

  printf '%s\n' ''
}

uvc_detect_firmware() {
  if [ -n "${UVC_RIO_FIRMWARE:-}" ]; then
    printf '%s\n' "$UVC_RIO_FIRMWARE"
    return
  fi

  for file in /etc/opto22-release /etc/groov-release
  do
    if [ -f "$file" ]; then
      firmware="$(grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' "$file" | head -n 1 || true)"
      if [ -n "$firmware" ]; then
        printf '%s\n' "$firmware"
        return
      fi
    fi
  done

  printf '%s\n' ''
}

uvc_json_field() {
  file="$1"
  expression="$2"
  node -e '
    const fs = require("node:fs");
    const data = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    const keys = process.argv[2].split(".");
    let value = data;
    for (const key of keys) value = value?.[key];
    if (Array.isArray(value)) process.stdout.write(value.join(" "));
    else if (value !== undefined && value !== null) process.stdout.write(String(value));
  ' "$file" "$expression"
}

uvc_version_at_least() {
  actual="$1"
  minimum="$2"
  node -e '
    const parse = value => value.split(".").map(part => Number.parseInt(part, 10));
    const left = parse(process.argv[1]);
    const right = parse(process.argv[2]);
    for (let index = 0; index < Math.max(left.length, right.length); index++) {
      const a = left[index] || 0;
      const b = right[index] || 0;
      if (a > b) process.exit(0);
      if (a < b) process.exit(1);
    }
    process.exit(0);
  ' "$actual" "$minimum"
}
